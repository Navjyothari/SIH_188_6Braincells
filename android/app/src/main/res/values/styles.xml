<?xml version="1.0" encoding="utf-8"?>
<!-- styles.xml
     Provides the two themes referenced in AndroidManifest.xml:
       - LaunchTheme: used during Flutter engine initialisation (splash).
         windowBackground is transparent/dark so Flutter's first frame
         appears without a white flash.
       - NormalTheme: applied after the engine is ready (via meta-data tag).
         Uses the standard Material light theme base. -->
<resources>
    <!-- LaunchTheme: shown while Flutter engine initialises.
         Keep windowBackground dark to avoid white-flash on startup. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- NormalTheme: applied after engine init via FlutterActivity meta-data.
         Flutter draws its own UI over this; the theme color only shows briefly. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
